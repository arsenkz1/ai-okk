// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ManagerRole {
  MANAGER
  TEAMLEAD
  ROP
}

model Team {
  id         Int       @id @default(autoincrement())
  name       String
  teamLeadId Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  members    Manager[]
}

model Manager {
  id             Int             @id @default(autoincrement())
  name           String
  amoUserId      Int?            @unique
  amoRoleId      Int?
  internalNumber String?         @unique
  timezone       String          @default("UTC")
  isActive       Boolean         @default(true)
  deactivatedAt  DateTime?

  role                       ManagerRole  @default(MANAGER)
  teamId                     Int?
  team                       Team?        @relation(fields: [teamId], references: [id])
  isDisciplinePilot          Boolean      @default(false)
  /// Set for accounts that are not salespeople (teams, HR, service logins).
  /// They keep their calls but stay out of rankings and company reports.
  excludeFromReports         Boolean      @default(false)
  isAmoCrmRestricted         Boolean      @default(false)
  amoRightsBeforeRestriction Json?

  telegramLinks  TelegramLink[]
  calls          Call[]
  dailySummaries DailySummary[]
  aiSessions     AiTrainerSession[]
  salesPlans     SalesPlan[]
  paymentEvents  DealPaymentEvent[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model BotAdmin {
  id             Int      @id @default(autoincrement())
  telegramUserId String   @unique
  addedBy        String?
  createdAt      DateTime @default(now())
}

model TelegramLink {
  id             Int       @id @default(autoincrement())
  manager        Manager   @relation(fields: [managerId], references: [id])
  managerId      Int

  telegramUserId String?   @unique
  oneTimeCode    String    @unique
  status         String    // issued | used | expired

  createdAt      DateTime  @default(now())
  usedAt         DateTime?
}

model Contact {
  id        Int       @id
  name      String?
  updatedAt DateTime  @updatedAt

  deals     Deal[]
  phones    PhoneMapping[]
}

model Deal {
  id              Int       @id
  contact         Contact?  @relation(fields: [contactId], references: [id])
  contactId       Int?

  pipelineId      Int
  statusId        Int
  name            String?

  /// amoCRM lead budget (price); used as the revenue amount for won deals.
  price               Int?
  /// amoCRM responsible_user_id at the last sync; attributes revenue to a manager.
  responsibleUserId   Int?

  updatedAt       DateTime  @updatedAt

  calls           Call[]
  phoneMappings   PhoneMapping[]
  paymentEvents   DealPaymentEvent[]
}

model PhoneMapping {
  id                 Int      @id @default(autoincrement())
  phoneNormalized    String   @unique

  contact            Contact? @relation(fields: [contactId], references: [id])
  contactId          Int?

  lastDeal           Deal?    @relation(fields: [lastDealId], references: [id])
  lastDealId         Int?
  lastDealUpdatedAt  DateTime?

  updatedAt          DateTime @updatedAt
}

model Call {
  id               Int           @id @default(autoincrement())
  externalId       String
  source           String        // 'onlinepbx'

  manager          Manager?      @relation(fields: [managerId], references: [id])
  managerId        Int?

  deal             Deal?         @relation(fields: [dealId], references: [id])
  dealId           Int?

  direction        String
  status           String

  startedAt        DateTime
  endedAt          DateTime
  durationSeconds  Int
  recordUrl        String?

  processingStatus String        // received|queued|transcribed|analyzed|sheet_synced|processed|skipped_short|no_deal|error
  processingAttempts Int        @default(0)
  lastError        String?
  manualTriggered  Boolean       @default(false)

  transcript       CallTranscript?
  analysis         CallAnalysis?
  taskActions      CallTaskAction[]
  stageActions     CallStageAction[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([externalId, source])
}

model CallTranscript {
  id        Int      @id @default(autoincrement())
  call      Call     @relation(fields: [callId], references: [id])
  callId    Int      @unique

  text      String
  engine    String?  // "gemini", "whisper", etc.
  language  String?
  metadata  Json?

  createdAt DateTime @default(now())
}

model CallAnalysis {
  id             Int      @id @default(autoincrement())
  call           Call     @relation(fields: [callId], references: [id])
  callId         Int      @unique

  overallScore   Float?
  criteria       Json?
  strengths      Json?
  weaknesses     Json?
  recommendations Json?
  summary        String?

  createdAt      DateTime @default(now())
}

model DailySummary {
  id               Int      @id @default(autoincrement())
  manager          Manager  @relation(fields: [managerId], references: [id])
  managerId        Int

  date             DateTime
  period           String   // day|week|month

  callsTotal       Int
  connectedTotal   Int
  talkTimeSeconds  Int
  avgScore         Float?

  topStrengths     Json?
  topMistakes      Json?
  summaryText      String?

  sentStatus       String   // pending|sent|error|skipped_no_tg

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([managerId, date, period])
}

model AiTrainerSession {
  id              Int      @id @default(autoincrement())
  manager         Manager  @relation(fields: [managerId], references: [id])
  managerId       Int

  question        String
  answer          String?
  period          String?
  contextSnapshot Json?

  createdAt       DateTime @default(now())
}

model HistorySyncJob {
  id                Int      @id @default(autoincrement())
  fromDate          DateTime
  toDate            DateTime
  managerId         Int?

  status            String   // pending|in_progress|completed|failed
  totalCallsScanned Int      @default(0)
  totalQueued       Int      @default(0)
  totalSkippedShort Int      @default(0)
  totalNoDeal       Int      @default(0)

  lastError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model LeadInactivitySetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model LeadInactivityWatch {
  leadId              Int      @id
  leadCreatedAt       DateTime @db.Timestamptz(3)
  lastActivityAt      DateTime @db.Timestamptz(3)
  lastActivityReceivedAt DateTime @db.Timestamptz(3)
  dueAt               DateTime @db.Timestamptz(3)
  pipelineId          Int
  statusId            Int
  cycle               Int      @default(1)
  state               String   @default("watching") // watching|leased|moved|outside_scope|skipped|uncertain
  leaseToken          String?
  leaseExpiresAt      DateTime? @db.Timestamptz(3)
  leaseGeneration     Int      @default(0)
  lastEventFingerprint String?
  stoppedAt           DateTime? @db.Timestamptz(3)
  lastFailureReason   String?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  @@index([state, dueAt])
  @@index([leaseExpiresAt])
}

model LeadInactivityEvent {
  id          Int      @id @default(autoincrement())
  fingerprint String   @unique
  leadId      Int
  eventType   String
  eventAt     DateTime @db.Timestamptz(3)
  receivedAt  DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([leadId, eventAt])
}

model LeadInactivityMoveAudit {
  id               String   @id @default(cuid())
  leadId           Int
  cycle            Int
  outcome          String   // reserved|confirmed|failed|skipped|uncertain
  sourcePipelineId Int?
  sourceStatusId   Int?
  targetPipelineId Int?
  targetStatusId   Int?
  eventCutoffAt    DateTime? @db.Timestamptz(3)
  slotNumber       Int?
  patchHttpStatus  Int?
  readbackPipelineId Int?
  readbackStatusId Int?
  errorClass       String?
  errorMessage     String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  completedAt      DateTime? @db.Timestamptz(3)

  @@index([leadId, createdAt])
  @@index([outcome])
}

model LeadInactivityTestSlot {
  slotNumber     Int      @id
  state          String   @default("free") // free|reserved|confirmed|uncertain
  leadId         Int?
  auditId        String?  @unique
  reservedAt     DateTime? @db.Timestamptz(3)
  confirmedAt    DateTime? @db.Timestamptz(3)
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@index([state, slotNumber])
  @@index([leaseExpiresAt])
}

model LeadInactivityDailyMovementSlot {
  bucketDate     String
  slotNumber     Int
  state          String   @default("free") // free|reserved|confirmed|uncertain
  leadId         Int?
  auditId        String?  @unique
  reservedAt     DateTime? @db.Timestamptz(3)
  confirmedAt    DateTime? @db.Timestamptz(3)
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@id([bucketDate, slotNumber])
  @@index([bucketDate, state, slotNumber])
  @@index([bucketDate, leaseExpiresAt])
}

model CallTaskAutomationSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model CallTaskAction {
  id                 String   @id @default(cuid())
  call               Call     @relation(fields: [callId], references: [id])
  callId             Int
  actionKind         String   @default("next_step")
  dealId             Int
  testMode           Boolean  @default(false)
  status             String   @default("analyzing") // analyzing|proposed|creating_task|task_confirmed|creating_note|confirmed|rejected|skipped|uncertain
  decision           String?  // auto|review|none
  taskText           String?  @db.Text
  evidence           String?  @db.Text
  proposedDueAt      DateTime? @db.Timestamptz(3)
  selectedDueAt      DateTime? @db.Timestamptz(3)
  responsibleUserId  Int?
  amoTaskId          Int?     @unique
  taskRequestId      String?  @unique
  noteText           String?  @db.Text
  amoNoteId          Int?     @unique
  approvalToken      String   @unique
  reviewedByTelegramUserId String?
  reviewedAt         DateTime? @db.Timestamptz(3)
  failureReason      String?  @db.Text
  analysisLeaseToken String?
  analysisLeaseExpiresAt DateTime? @db.Timestamptz(3)
  analysisLeaseGeneration Int @default(0)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  testSlot           CallTaskAutomationTestSlot? @relation("CallTaskActionSlot")

  @@unique([callId, actionKind])
  @@index([status, createdAt])
  @@index([status, analysisLeaseExpiresAt])
  @@index([dealId, createdAt])
}

model CallTaskAutomationTestSlot {
  slotNumber     Int      @id
  state          String   @default("free") // free|reserved|confirmed|uncertain
  dealId         Int?     @unique
  action         CallTaskAction? @relation("CallTaskActionSlot", fields: [actionId], references: [id], onDelete: SetNull)
  actionId       String?  @unique
  reservedAt     DateTime? @db.Timestamptz(3)
  confirmedAt    DateTime? @db.Timestamptz(3)
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@index([state, slotNumber])
  @@index([leaseExpiresAt])
}

model CallStageAutomationSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model CallStageAction {
  id                 String   @id @default(cuid())
  call               Call     @relation(fields: [callId], references: [id])
  callId             Int      @unique
  dealId             Int
  testMode           Boolean  @default(true)
  status             String   @default("analyzing") // analyzing|review|pending_move|moving|blocked_missing_fields|confirmed|skipped|uncertain
  decision           String?  // move|review|none
  target             String?
  evidence           String?  @db.Text
  checkedFields      Json?
  missingFields      Json?
  amoNoteId          Int?     @unique
  failureReason      String?  @db.Text
  analysisLeaseToken String?
  analysisLeaseExpiresAt DateTime? @db.Timestamptz(3)
  analysisLeaseGeneration Int @default(0)
  mutationLeaseToken String?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  testSlot           CallStageAutomationTestSlot? @relation("CallStageActionSlot")

  @@index([status, createdAt])
  @@index([status, analysisLeaseExpiresAt])
  @@index([dealId, createdAt])
}

model CallStageAutomationTestSlot {
  slotNumber     Int      @id
  state          String   @default("free") // free|reserved|confirmed|uncertain
  dealId         Int?     @unique
  action         CallStageAction? @relation("CallStageActionSlot", fields: [actionId], references: [id], onDelete: SetNull)
  actionId       String?  @unique
  reservedAt     DateTime? @db.Timestamptz(3)
  confirmedAt    DateTime? @db.Timestamptz(3)
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@index([state, slotNumber])
  @@index([leaseExpiresAt])
}

/// One recorded entry of a deal into a revenue-bearing stage. Uniqueness on
/// (dealId, statusId) makes a replayed amoCRM webhook idempotent and stops a
/// deal from being counted twice for the same stage.
model DealPaymentEvent {
  id           String   @id @default(cuid())
  deal         Deal     @relation(fields: [dealId], references: [id])
  dealId       Int
  pipelineId   Int
  statusId     Int
  /// 'won' for the system success status, 'partial' for a part-paid stage.
  kind         String
  /// Null when the source amount is not configured yet; such rows count toward
  /// the deal count but contribute nothing to any sum.
  amount       Int?
  currency     String   @default("UZS")
  manager      Manager? @relation(fields: [managerId], references: [id])
  managerId    Int?
  amoUserId    Int?
  occurredAt   DateTime @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@unique([dealId, statusId])
  @@index([occurredAt])
  @@index([managerId, occurredAt])
  @@index([kind, occurredAt])
}

/// Monthly revenue target per manager. A team target is the sum of its
/// members' targets, so no separate team row exists.
model SalesPlan {
  id           Int      @id @default(autoincrement())
  manager      Manager  @relation(fields: [managerId], references: [id])
  managerId    Int
  /// Local Almaty calendar month the target applies to.
  year         Int
  month        Int
  amountTarget BigInt
  currency     String   @default("UZS")
  setByTelegramUserId String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@unique([managerId, year, month])
  @@index([year, month])
}

/// The option list a select field had before this system ever modified it.
/// Written once per field and never overwritten, so the original spelling and
/// ordering stay recoverable no matter how many options are added later.
model AmoFieldOptionSnapshot {
  fieldId     Int      @id
  fieldName   String
  fieldType   String
  /// Full enums array as amoCRM returned it: [{ id, value, sort }].
  originalEnums Json
  capturedAt  DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

/// One option this system added to an amoCRM field. Kept so additions can be
/// rolled back individually, without disturbing options people added by hand.
model AmoFieldOptionAddition {
  id         String   @id @default(cuid())
  fieldId    Int
  fieldName  String
  enumId     Int
  value      String
  /// Call-stage action that caused the addition, for tracing back to a call.
  actionId   String?
  dealId     Int?
  /// Set when the option has been removed again by a rollback.
  revertedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([fieldId, enumId])
  @@index([fieldId, revertedAt])
  @@index([createdAt])
}

/// Revenue-bearing stages discovered from amoCRM by /sync_stages.
/// Pipelines are added and renamed in the CRM, so the list is synced rather
/// than hardcoded; the webhook consults this table on every status change.
model RevenueStage {
  pipelineId   Int
  statusId     Int
  /// 'won' for a realized deal, 'partial' for a part-paid one.
  kind         String
  pipelineName String
  statusName   String
  syncedAt     DateTime @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@id([pipelineId, statusId])
  @@index([kind])
}

/// Every call_end webhook OnlinePBX delivers, including calls too short to be
/// analyzed. The call-processing pipeline stores only conversations over six
/// minutes, so without this table "how many calls were there" can only be
/// answered by re-reading the OnlinePBX history API — which fails whenever the
/// session key lapses.
model PbxCallLog {
  uuid           String   @id
  direction      String
  internalNumber String?
  externalNumber String?
  startedAt      DateTime @db.Timestamptz(3)
  /// Total call length including ringing.
  callSeconds    Int
  /// Talk time; zero means nobody answered.
  talkSeconds    Int
  hangupCause    String?
  receivedAt     DateTime @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([startedAt])
  @@index([internalNumber, startedAt])
}
